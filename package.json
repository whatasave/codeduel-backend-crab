{
  "name": "codeduel-backend-crab",
  "devDependencies": {
    "@types/bun": "1.2.4",
    "editorconfig": "^2.0.1",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "3.5.2",
    "typescript": "npm:@tsc-rs/typescript@0.8.0"
  },
  "overrides": {
    "typescript": "npm:@tsc-rs/typescript@0.8.0"
  },
  "trustedDependencies": [
    "typescript"
  ],
  "private": true,
  "scripts": {
    "build": "bun run --cwd ./packages/api build",
    "start": "bun run --cwd ./packages/api start",
    "api": "bun run --cwd ./packages/api",
    "db": "bun run --cwd ./packages/database",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint": "oxlint",
    "typecheck": "bun run --cwd ./packages/api typecheck && bun run --cwd ./packages/database typecheck && bun run --cwd ./packages/logger typecheck"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
